# Copiar a frpc.toml y ajustar (no commitear con token real)
serverAddr = "dtunnel.desarrollado.com"
serverPort = 7000

auth.method = "token"
auth.token = "TU_FRPS_TOKEN"

# Sustituir NAME y PORT al ejecutar dtunnel.sh up NAME PORT
[[proxies]]
name = "NAME"
type = "http"
localIP = "127.0.0.1"
localPort = PORT
subdomain = "NAME"
